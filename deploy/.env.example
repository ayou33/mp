# mp 部署环境变量(复制为 .env 后按需修改)
# 用法:cp .env.example .env && docker compose up -d --build

# backend 监听端口(容器内固定 3000 被 compose 覆盖,此处一般无需改)
PORT=3000

# SQLite 数据库路径(容器内路径,由 compose 覆盖为卷路径)
# DB_PATH=/app/backend-server/data/mp.db

# 可选:腾讯行情接口地址覆盖(一般不用动)
# TENCENT_BASE=https://web.ifzq.gtimg.cn/appstock/app/fqkline/get
